      const gainNode = audioCtx.createGain();
      oscillator.type = 'sine';
      oscillator.frequency.setValueAtTime(880, audioCtx.currentTime);
      gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
      oscillator.connect(gainNode);
      gainNode.connect(audioCtx.destination);
      oscillator.start();
      oscillator.stop(audioCtx.currentTime + 0.3);
    } catch (e) {
      console.error('Erro ao reproduzir o bip sonoro:', e);
    }
  }

 /** Toca um beep quando o tempo restante bate em 15, 10, 5 ou 0 segundos (uma vez por marca). */
function checarBeepFinal(segundosRestantes) {
  const marcas = [15, 10, 5, 0];
  if (marcas.includes(segundosRestantes) && lastBeepedSecond !== segundosRestantes) {
    playBeep();
    lastBeepedSecond = segundosRestantes;
  }
}

