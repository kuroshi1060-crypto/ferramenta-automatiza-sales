      await withTimeout((resolve, retry) => {
        const findDeep = (root, selector, text) => {
          const els = root.querySelectorAll(selector);
          for (const el of els) { if (!text || el.innerText?.trim() === text) return el; }
          for (const el of root.querySelectorAll("*")) {
            if (el.shadowRoot) { const f = findDeep(el.shadowRoot, selector, text); if (f) return f; }
          }
        };
        const combo = findDeep(document, 'button[aria-label="Domínios Definidos"]');
        if (combo) {
          if (combo.getAttribute("aria-expanded") !== "true") { combo.click(); }
          else {
            const option = findDeep(document, '[role="option"], lightning-base-combobox-item', dominio);
            if (option) { option.click(); resolve(); return; }
          }
        }
        setTimeout(retry, 200);
