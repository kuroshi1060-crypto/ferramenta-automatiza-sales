    restaurarLarguraCustomizada(); // garante que, se a feature for desligada com o painel "encolhido", ele volte ao tamanho certo
    return;
  }

  const emFoco = isHoveringPanel || isFocusInsidePanel;
  panelOverlay.classList.toggle("fa-unfocused", !emFoco);

  if (!emFoco) {
    encolherTemporariamente();
  } else {
    restaurarLarguraCustomizada();
  }
}

/** Guarda a largura atual (se for diferente da padrão) e encolhe o painel para o tamanho padrão. */
function encolherTemporariamente() {
  if (!panelOverlay) return;
  const larguraAtual = panelOverlay.getBoundingClientRect().width;
  // Só guarda/encolhe se o painel estiver maior que o padrão (evita "encolher" quando já está no padrão ou menor)
  if (larguraAtual > DEFAULT_PANEL_WIDTH + 1) {
    larguraCustomizada = larguraAtual;
    panelOverlay.style.width = `${DEFAULT_PANEL_WIDTH}px`;
  }
}

/** Restaura a largura customizada guardada (se houver) ao voltar o foco. */
function restaurarLarguraCustomizada() {
  if (!panelOverlay) return;
  if (larguraCustomizada !== null) {
    panelOverlay.style.width = `${larguraCustomizada}px`;
    larguraCustomizada = null;
  }
}

