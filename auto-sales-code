  function obterRecordId() {
    const m = location.pathname.match(/\/lightning\/r\/[^/]+\/([^/]+)\//);
    return m ? m[1] : null;
  }

  const TIMEOUT_MAX = 1000;

  function withTimeout(executor, stepName) {
    return new Promise((resolve, reject) => {
      const start = Date.now();
      function check() {
        if (Date.now() - start > TIMEOUT_MAX) { reject(`⏰ Timeout: ${stepName}`); return; }
        executor(resolve, check);
      }
      check();
    });
  }

  function traverseDOM(node, test) {
    if (!node) return null;
    if (test(node)) return node;
    let found = null;
    if (node.shadowRoot) found = traverseDOM(node.shadowRoot, test);
    if (!found && node.children?.length) {
      for (const c of node.children) {
        found = traverseDOM(c, test);
        if (found) break;
      }
    }
    return found;
  }

  function setCheckboxByName(fieldName, checked, resolve, retry, log) {
    const cb = traverseDOM(document, n =>
      n.nodeName === "INPUT" && n.type === "checkbox" && n.name === fieldName && !n.disabled
    );
    if (cb) {
      cb.checked = checked;
      cb.dispatchEvent(new Event("input",  { bubbles: true }));
      cb.dispatchEvent(new Event("change", { bubbles: true }));
      console.log(log); resolve();
    } else { setTimeout(retry, 300); }
  }

  function clicarBotaoEditar(resolve, retry) {
    const btn = traverseDOM(document, n =>
      n.nodeName === "BUTTON" && n.getAttribute("title") === "Editar Nacionalidade"
    );
    if (btn) {
      btn.scrollIntoView({ behavior: "smooth", block: "center" });
      btn.focus(); btn.click(); resolve();
    } else { setTimeout(retry, 300); }
  }

  function alterarEmailInput(nameEmail, resolve, retry) {
    (function find(root = document) {
      const input = root.querySelector?.('input[name="emailName__c"]');
      if (input) {
        input.value = nameEmail;
        input.dispatchEvent(new Event("input",  { bubbles: true }));
        input.dispatchEvent(new Event("change", { bubbles: true }));
        resolve(); return;
      }
      root.querySelectorAll?.("*").forEach(el => el.shadowRoot && find(el.shadowRoot));
    })();
    setTimeout(retry, 300);
  }

  function clicarBotaoSalvar() {
    const normalize = t => t?.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
    const btn = traverseDOM(document, n =>
      n.nodeName === "BUTTON" && (n.name === "SaveEdit" || normalize(n.innerText) === "salvar")
    );
    if (btn) { btn.scrollIntoView({ behavior: "smooth", block: "center" }); btn.focus(); btn.click(); }
    else console.warn("❌ Botão Salvar não encontrado");
  }

