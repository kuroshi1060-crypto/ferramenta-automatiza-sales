        if (!base64String) return pedacos;
        for (let i = 0; i < base64String.length; i += tamanhoPedaco) {
            pedacos.push(base64String.substring(i, i + tamanhoPedaco));
        }
        return pedacos;
    }

    function converterImagemParaSVG(file, maxDimensao = 900, qualidade = 0.60, limiteCaracteresFoto = 32000) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = (e) => {
                const img = new Image();
                img.onload = () => {
                    const canvas = document.createElement('canvas');
                    const ctx = canvas.getContext('2d');
                    ctx.imageSmoothingEnabled = true;
                    ctx.imageSmoothingQuality = 'high';

                    let w = img.width || 800;
                    let h = img.height || 600;
                    let dimAtual = maxDimensao;
                    let qualAtual = qualidade;
                    let base64Resultado = '';
                    let formato = 'image/webp';

                    if (!canvas.toDataURL('image/webp').startsWith('data:image/webp')) {
                        formato = 'image/jpeg';
                    }

                    for (let tentativa = 0; tentativa < 5; tentativa++) {
                        let tempW = w;
                        let tempH = h;

                        if (tempW > dimAtual || tempH > dimAtual) {
                            if (tempW > tempH) {
                                tempH = Math.round((tempH * dimAtual) / tempW);
                                tempW = dimAtual;
                            } else {
                                tempW = Math.round((tempW * dimAtual) / tempH);
                                tempH = dimAtual;
                            }
                        }

                        canvas.width = tempW;
                        canvas.height = tempH;
                        ctx.drawImage(img, 0, 0, tempW, tempH);

                        base64Resultado = canvas.toDataURL(formato, qualAtual);

                        if (base64Resultado.length <= limiteCaracteresFoto || tentativa === 4) {
                            w = tempW;
                            h = tempH;
                            break;
                        }

                        dimAtual = Math.round(dimAtual * 0.82);
                        qualAtual = Math.max(0.25, qualAtual - 0.12);
                    }

                    const svgString = `<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 ${w} ${h}" width="100%" height="auto"><image width="${w}" height="${h}" xlink:href="${base64Resultado}"/></svg>`;
                    resolve(svgString);
                };
                img.onerror = reject;
                img.src = e.target.result;
            };
            reader.onerror = reject;
            reader.readAsDataURL(file);
        });
    }

    function extrairListaImagens(strImagens) {
        if (!strImagens) return [];
        const str = String(strImagens).trim();
        if (!str) return [];

        const svgs = str.match(/<svg[\s\S]*?<\/svg>/gi);
        if (svgs && svgs.length > 0) return svgs;

        return str.split(/\n+/).map(s => s.trim()).filter(Boolean);
    }

