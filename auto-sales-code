    // =========================================================================
    // ENVIO DIRETO VIA GM_xmlhttpRequest
    // =========================================================================
    function enviarViaGoogleForms(formConfig, dados, onSucesso) {
        if (!formConfig || !formConfig.actionUrl) {
            mostrarToast("⚠️ Formulário automático não configurado.");
            return;
        }

        try {
            const bodyData = new URLSearchParams();

            Object.keys(formConfig.entryIds).forEach(key => {
                const entryId = formConfig.entryIds[key];
                if (entryId && dados[key] !== undefined) {
                    bodyData.append(entryId, dados[key]);
                }
            });

            GM_xmlhttpRequest({
                method: "POST",
                url: formConfig.actionUrl,
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                data: bodyData.toString(),
                onload: function () {
                    if (onSucesso) onSucesso();
                },
                onerror: function (err) {
                    console.error("Erro no envio ao Forms:", err);
                    mostrarToast('❌ Erro de conexão ao enviar o formulário.');
                }
            });
        } catch (err) {
            console.error("Erro ao estruturar envio para o Forms:", err);
            mostrarToast('❌ Erro ao preparar formulário.');
        }
    }

