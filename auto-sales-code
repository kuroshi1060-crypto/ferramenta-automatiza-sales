    let historicoAtual = JSON.parse(localStorage.getItem("revisor_historico") || "[]");

    const agora = new Date();

    const novoRegistro = {
        id: Date.now(),
        dataHora: agora.toLocaleString("pt-BR", {
            day: "2-digit",
            month: "2-digit",
            year: "numeric",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit"
        }),
        data: agora.toLocaleDateString("pt-BR"),
        hora: agora.toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit", second: "2-digit" }),
        nome: nome,
