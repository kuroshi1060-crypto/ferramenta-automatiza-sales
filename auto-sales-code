    /** Seleciona, num <select>, a <option> cujo texto visível bate com `texto` (case/acentos ignorados). */
    function selecionarPorTexto(select, texto) {
      if (!select || !texto) return false;
      const normalize = t => t?.normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim().toUpperCase();
      const alvo = normalize(texto);
      const option = Array.from(select.options).find(opt => normalize(opt.textContent) === alvo);
      if (option) {
        select.value = option.value;
        select.dispatchEvent(new Event("change", { bubbles: true }));
        return true;
      }
      return false;
    }
