        textoOriginal: localStorage.getItem("revisor_original") || obs,
        textoRevisado: localStorage.getItem("revisor_revisado") || obs,
        observacao: obs
    };

    historicoAtual.push(novoRegistro);

    if (historicoAtual.length > MAX_HISTORICO) {
        historicoAtual = historicoAtual.slice(-MAX_HISTORICO);
    }

    localStorage.setItem("revisor_historico", JSON.stringify(historicoAtual));
}

