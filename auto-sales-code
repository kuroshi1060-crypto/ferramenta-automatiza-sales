// FUNÇÃO FÁBRICA: configura um bloco de pesquisa isoladamente
function inicializarBlocoDeCidade(containerId, dados) {
    const container = document.getElementById(containerId);
    const inputCidade = container.querySelector(".input-cidade");
    const inputEmail = container.querySelector(".input-email-loja");
    const listaSugestoes = container.querySelector(".lista-sugestoes");
    const resultadoBloco = container.querySelector(".resultado-bloco");
    const resCidade = container.querySelector(".res-cidade");
    const resEmail = container.querySelector(".res-email");

    const cidadesOrdenadas = Object.keys(dados).sort((a, b) => a.localeCompare(b, 'pt-BR'));

    function inicializarLista() {
        listaSugestoes.innerHTML = "";
        cidadesOrdenadas.forEach(cidade => {
            const li = document.createElement("li");
            li.className = "dropdown-item";
            li.textContent = cidade;
            li.addEventListener("click", () => {
                selecionarCidade(cidade);
            });
            listaSugestoes.appendChild(li);
        });
    }

    inputCidade.addEventListener("input", () => {
        const valorFiltro = inputCidade.value.toLowerCase();
        const itens = listaSugestoes.getElementsByClassName("dropdown-item");
        listaSugestoes.style.display = "block";
        for (let item of itens) {
            const texto = item.textContent.toLowerCase();
            item.style.display = texto.includes(valorFiltro) ? "block" : "none";
        }
        // se o texto for editado manualmente, o e-mail selecionado deixa de ser válido
        inputEmail.value = "";
    });

    inputCidade.addEventListener("focus", () => {
        listaSugestoes.style.display = "block";
    });

    inputCidade.addEventListener("blur", () => {
        setTimeout(() => {
            listaSugestoes.style.display = "none";
        }, 200);
    });

    function selecionarCidade(cidade) {
        inputCidade.value = cidade;            // exibe o nome da cidade
        listaSugestoes.style.display = "none";

        const emails = dados[cidade];
        if (emails && emails.length > 0) {
            inputEmail.value = emails[0];       // valor real (e-mail) usado no envio
            resEmail.textContent = emails[0];
            resultadoBloco.style.display = "block";
        } else {
            inputEmail.value = "";
            resultadoBloco.style.display = "none";
        }
    }

    inicializarLista();
}

