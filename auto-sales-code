    // ── FUNÇÃO FÁBRICA: configura a busca de cidade e a exibição das lojas ──
    function inicializarBuscaCidade(containerId, dados) {
        const container = document.getElementById(containerId);
        const inputCidade = container.querySelector(".input-cidade");
        const listaSugestoes = container.querySelector(".lista-sugestoes");
        const resultadoLojas = container.querySelector("#resultado-lojas");

        const cidadesOrdenadas = Object.keys(dados).sort((a, b) => a.localeCompare(b, 'pt-BR'));

        function inicializarLista() {
            listaSugestoes.innerHTML = "";
            cidadesOrdenadas.forEach(cidade => {
                const li = document.createElement("li");
                li.className = "dropdown-item";
                li.textContent = cidade;
                li.addEventListener("click", () => selecionarCidade(cidade));
                listaSugestoes.appendChild(li);
            });
        }

        inputCidade.addEventListener("input", () => {
            const valorFiltro = inputCidade.value.toLowerCase();
            const itens = listaSugestoes.getElementsByClassName("dropdown-item");
            listaSugestoes.style.display = "block";
            for (let item of itens) {
                item.style.display = item.textContent.toLowerCase().includes(valorFiltro) ? "block" : "none";
            }
        });

        inputCidade.addEventListener("focus", () => { listaSugestoes.style.display = "block"; });
        inputCidade.addEventListener("blur", () => {
            setTimeout(() => { listaSugestoes.style.display = "none"; }, 200);
        });

        /** Ao selecionar a cidade, monta um cartão para cada loja encontrada (separadas por bairro). */
        function selecionarCidade(cidade) {
            inputCidade.value = cidade;
            listaSugestoes.style.display = "none";

            const lojas = dados[cidade];
            if (!lojas || lojas.length === 0) {
                resultadoLojas.innerHTML = `<div class="loja-card">Nenhuma loja encontrada para esta cidade.</div>`;
                resultadoLojas.style.display = "block";
                return;
            }

            resultadoLojas.innerHTML = lojas.map(loja => `
                <div class="loja-card">
                    <div class="bairro">${loja.bairro}</div>
                    <div class="endereco">${loja.endereco}</div>
                    <div class="horario">Horário: ${loja.horario}</div>
                </div>
            `).join("");
            resultadoLojas.style.display = "block";
        }

        inicializarLista();
    }

    inicializarBuscaCidade("bloco-lojas", dadosLojas);

    document.getElementById("fa-back").onclick = abrirLojasCidade;
}


