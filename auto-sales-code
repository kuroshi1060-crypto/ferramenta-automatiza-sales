    // =========================================================================
    // FUNÇÃO AUXILIAR: REQUISIÇÃO COM TENTATIVAS (RETRY + EXPONENTIAL BACKOFF)
    // =========================================================================
    async function fetchGeminiComRetry(url, payload, maxTentativas = 5, delayInicial = 1000, onRetry = null) {
        let atraso = delayInicial;

        for (let tentativa = 1; tentativa <= maxTentativas; tentativa++) {
            try {
                const res = await fetch(url, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });

                if (!res.ok) {
                    const e = await res.json().catch(() => ({}));
                    const msg = e?.error?.message || `HTTP ${res.status}`;

                    // Se for erro de alta demanda (429, 500, 503, 504) e ainda houver tentativas
                    if ((res.status === 429 || res.status >= 500) && tentativa < maxTentativas) {
                        if (onRetry) onRetry(tentativa, maxTentativas, atraso);
                        await new Promise(resolve => setTimeout(resolve, atraso));
                        atraso *= 2; // Dobra o tempo de espera a cada erro (1s, 2s, 4s, 8s)
                        continue;
                    }
                    throw new Error(msg);
                }

                return await res.json();
            } catch (err) {
                // Se for a última tentativa, repassa o erro para ser tratado no bloco catch principal
                if (tentativa === maxTentativas) {
                    throw err;
                }

                if (onRetry) onRetry(tentativa, maxTentativas, atraso);
                await new Promise(resolve => setTimeout(resolve, atraso));
                atraso *= 2;
            }
        }
