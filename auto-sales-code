function salvarHistoricoOuvidoria() {
    const obs = document.getElementById("fa-observacao-ouvidoria")?.value || "";
    const nome = document.getElementById("fa-nome-ouvidoria")?.value || "";
    const uc = document.getElementById("fa-uc-instalacao-ouvidoria")?.value || "";

