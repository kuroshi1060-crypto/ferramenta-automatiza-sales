// FUNÇÃO FÁBRICA: configura o bloco de pesquisa da Área Responsável
function inicializarBlocoDeArea(containerId, dados) {
    const container = document.getElementById(containerId);
    if (!container) return; // Segurança caso o HTML não esteja na tela

    const inputArea = container.querySelector(".input-area");
    const inputEmail = container.querySelector(".input-email-area");
    const listaSugestoes = container.querySelector(".lista-sugestoes");
    const resultadoBloco = container.querySelector(".resultado-bloco");
    const resArea = container.querySelector(".res-area");
    const resEmail = container.querySelector(".res-email");

    // Ordena as áreas em ordem alfabética
    const areasOrdenadas = Object.keys(dados).sort((a, b) => a.localeCompare(b, 'pt-BR'));

    function inicializarLista() {
        listaSugestoes.innerHTML = "";
        areasOrdenadas.forEach(area => {
            const li = document.createElement("li");
            li.className = "dropdown-item";
            li.textContent = area;
            li.addEventListener("click", () => {
                selecionarArea(area);
            });
            listaSugestoes.appendChild(li);
        });
    }

    inputArea.addEventListener("input", () => {
        const valorFiltro = inputArea.value.toLowerCase();
        const itens = listaSugestoes.getElementsByClassName("dropdown-item");

        listaSugestoes.style.display = "block";

        for (let item of itens) {
            const texto = item.textContent.toLowerCase();
            item.style.display = texto.includes(valorFiltro) ? "block" : "none";
        }

        // Se o texto for editado manualmente, o e-mail selecionado e o resultado somem
        inputEmail.value = "";
        resultadoBloco.style.display = "none";
    });

    inputArea.addEventListener("focus", () => {
        listaSugestoes.style.display = "block";
    });

    inputArea.addEventListener("blur", () => {
        setTimeout(() => {
            listaSugestoes.style.display = "none";
        }, 200);
    });

    function selecionarArea(area) {
        inputArea.value = area;            // Preenche o input visível com o nome da área
        listaSugestoes.style.display = "none"; // Esconde a lista suspensa

        const emails = dados[area];
        if (emails && emails.length > 0) {
            inputEmail.value = emails[0];       // Preenche o input oculto com o e-mail real
            resArea.textContent = area;
            resEmail.textContent = emails[0];
            resultadoBloco.style.display = "none"; // Mostra a caixinha de resultado
        } else {
            inputEmail.value = "";
            resultadoBloco.style.display = "none";
        }
    }

    inicializarLista();
