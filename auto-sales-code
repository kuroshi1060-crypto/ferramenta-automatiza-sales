        /**
 * Espera um elemento desaparecer do DOM usando MutationObserver (reage
 * instantaneamente à mudança, em vez de checar a cada X ms como o
 * polling). Mais rápido que setInterval porque não tem "delay médio"
 * entre a mudança acontecer e ser detectada.
 */
function aguardarElementoSumirRapido(id, callback, timeoutMs = 8000) {
  const elemento = document.getElementById(id);
  if (!elemento) { callback(); return; }

  const observer = new MutationObserver(() => {
    if (!document.getElementById(id)) {
      observer.disconnect();
      clearTimeout(timeoutId);
      callback();
    }
  });

  observer.observe(document.body, { childList: true, subtree: true });

  const timeoutId = setTimeout(() => {
    observer.disconnect();
    console.warn(`⏰ Timeout esperando "${id}" sumir`);
    callback(); // segue mesmo assim, como fallback
  }, timeoutMs);
}

/**
 * Aguarda o botão "Salvar" desaparecer do DOM (sinal de que o AJAX.Submit
 * terminou e a página foi re-renderizada) para então clicar em
 * "Iniciar interação". Usa polling em vez de tempo fixo, pra não depender
 * de "chutar" quanto tempo o servidor vai demorar.
 */
/**
 * Aguarda o botão "Salvar" desaparecer do DOM (sinal de que o AJAX.Submit
 * terminou e a página foi re-renderizada) para então clicar em
 * "Iniciar interação". Usa MutationObserver em vez de polling — reage
 * instantaneamente à mudança no DOM, sem esperar o próximo "tick" de
 * verificação, o que reduz o atraso percebido em comparação ao clique manual.
 */
function aguardarSaveButtonSumir(timeoutMs = 8000) {
  const ID_SALVAR = "endInteraction:j_id2:idPageBlock:mypageblock:saveButton";
  const ID_INICIAR = "endInteraction:j_id2:idPageBlock:mypageblock:openButton";

  function clicarIniciar() {
    const btnIniciar = document.getElementById(ID_INICIAR);
    if (btnIniciar) {
      btnIniciar.click();
    } else {
      console.warn("❌ Botão 'Iniciar interação' não encontrado após o Salvar sumir");
    }
    gmDeleteValue(START_INTERACTION_KEY);
  }

  // Se já sumiu antes mesmo de montar o observer, segue direto
  if (!document.getElementById(ID_SALVAR)) {
    clicarIniciar();
    return;
  }

  let finalizado = false;

  const observer = new MutationObserver(() => {
    if (finalizado) return;
    if (!document.getElementById(ID_SALVAR)) {
      finalizado = true;
      observer.disconnect();
      clearTimeout(timeoutId);
      clicarIniciar();
    }
  });

  observer.observe(document.body, { childList: true, subtree: true });

  // Salvaguarda: se o botão nunca sumir (erro no AJAX, etc.), desiste
  // após o tempo limite em vez de ficar observando para sempre.
  const timeoutId = setTimeout(() => {
    if (finalizado) return;
    finalizado = true;
    observer.disconnect();
    console.warn("⏰ Timeout esperando o botão 'Salvar' sumir");
    gmDeleteValue(START_INTERACTION_KEY);
  }, timeoutMs);
}

