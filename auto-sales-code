            const processarEConverterImagens = async () => {
                const files = Array.from(fileInput.files);
                if (!files || files.length === 0) return;

                try {
                    previewBox.style.display = 'flex';
                    previewBox.innerHTML = '<span style="font-size:12px; color:var(--kbp-subtext);">🔄 Otimizando e convertendo imagem(ns)...</span>';

                    const ORCAMENTO_TOTAL_CHARS = 32000;
                    const totalArquivos = files.length;
                    const limitePorFoto = Math.floor(ORCAMENTO_TOTAL_CHARS / totalArquivos);

                    let maxDim = 900;
                    let qual = 0.65;
                    const qVal = qualidadeSelect ? qualidadeSelect.value : 'media';

                    if (qVal === 'baixa') {
                        maxDim = 600;
                        qual = 0.40;
                    } else if (qVal === 'alta') {
                        maxDim = 1200;
                        qual = 0.80;
                    }

                    const svgs = [];
                    for (const file of files) {
                        const svgStr = await converterImagemParaSVG(file, maxDim, qual, limitePorFoto);
                        svgs.push(svgStr);
                    }

                    const totalString = svgs.join('\n');

                    if (totalString.length > 36000) {
                        throw new Error("O tamanho total das imagens excede o limite aceito pelo formulário. Tente selecionar 'Qualidade Baixa' ou enviar menos imagens.");
                    }

                    svgImagemConvertida = totalString;
                    previewBox.innerHTML = '';

