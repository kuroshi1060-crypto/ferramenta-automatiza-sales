    // FUNÇÃO FABRICA: Configura um bloco de pesquisa isoladamente
    function inicializarBlocoDePesquisa(containerId, dados) {
        // Encontra o contêiner principal pelo ID (bloco-informacao ou bloco-reclamacao)
        const container = document.getElementById(containerId);

        // Em seguida, busca os elementos internos deste contêiner usando as Classes
        const inputAssunto = container.querySelector(".input-assunto");
        const listaSugestoes = container.querySelector(".lista-sugestoes");
        const resultadoBloco = container.querySelector(".resultado-bloco");
        const resTipo = container.querySelector(".res-tipo");
        const resMotivo = container.querySelector(".res-motivo");
        const resSubmotivo = container.querySelector(".res-submotivo");

        // Ordenação e Inicialização
        const assuntosOrdenados = Object.keys(dados).sort((a, b) => a.localeCompare(b, 'pt-BR'));

        function inicializarLista() {
            listaSugestoes.innerHTML = "";
            assuntosOrdenados.forEach(assunto => {
                const li = document.createElement("li");
                li.className = "dropdown-item";
                li.textContent = assunto;

                li.addEventListener("click", () => {
                    selecionarAssunto(assunto);
                });
                listaSugestoes.appendChild(li);
            });
        }

        // Filtros e Interações específicos para este bloco
        inputAssunto.addEventListener("input", () => {
            const valorFiltro = inputAssunto.value.toLowerCase();
            const itens = listaSugestoes.getElementsByClassName("dropdown-item");

            listaSugestoes.style.display = "block";

            for (let item of itens) {
                const texto = item.textContent.toLowerCase();
                if (texto.includes(valorFiltro)) {
                    item.style.display = "block";
                } else {
                    item.style.display = "none";
                }
            }
        });

        inputAssunto.addEventListener("focus", () => {
            listaSugestoes.style.display = "block";
        });

        inputAssunto.addEventListener("blur", () => {
            setTimeout(() => {
                listaSugestoes.style.display = "none";
            }, 200);
        });

        function selecionarAssunto(assunto) {
            inputAssunto.value = assunto;
            listaSugestoes.style.display = "none";

            if (dados[assunto]) {
                resTipo.textContent = dados[assunto].tipo;
                resMotivo.textContent = dados[assunto].motivo;
                resSubmotivo.textContent = dados[assunto].submotivo;
                resultadoBloco.style.display = "block";
            }
        }

        // Executa a carga inicial da lista para este bloco
        inicializarLista();
    }

    // Inicializando os dois blocos separadamente
    // Eles funcionam com a mesma lógica, mas são completamente independentes
    inicializarBlocoDePesquisa("bloco-informacao", dadosInformacao);
    inicializarBlocoDePesquisa("bloco-reclamacao", dadosReclamacao);

