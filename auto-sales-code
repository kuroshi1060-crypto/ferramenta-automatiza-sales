  function formatTime(seconds) {
    const isNegative = seconds < 0;
    const absSecs = Math.abs(seconds);
    const mins = Math.floor(absSecs / 60);
    const secs = absSecs % 60;
    const formatted = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    return isNegative ? `-${formatted}` : formatted;
  }

  function getColorForTime(seconds) {
    if (seconds >= 0) {
      const ratio = seconds / 120;
      const r = Math.round(255 - ratio * (255 - 48));
      const g = Math.round(69 + ratio * (209 - 69));
      const b = Math.round(58 + ratio * (58 - 58));
      return `rgb(${r}, ${g}, ${b})`;
    } else {
      const ratio = Math.min(Math.abs(seconds) / 1200, 1);
      const r = Math.round(255 - ratio * (255 - 90));
      const g = Math.round(69 * (1 - ratio));
      const b = Math.round(58 * (1 - ratio));
      return `rgb(${r}, ${g}, ${b})`;
    }
  }

