}

  function startTimer() {
    if (isRunning || !widget) return;
    isRunning = true;
    endTime = Date.now() + (timeLeft * 1000);
    toggleBtn.innerHTML = pauseIcon;
    toggleBtn.title = 'Pausar';
    saveState();
    runInterval();
  }

  function pauseTimer() {
    if (!isRunning) return;
    clearInterval(timerInterval);
    isRunning = false;
    endTime = null;
    toggleBtn.innerHTML = playIcon;
    toggleBtn.title = 'Retomar';
    saveState();
  }

  /** Zera o cronômetro para o valor padrão (2 minutos), sem iniciar a contagem. */
  function resetTimer() {
    if (resetBtn) {
      resetBtn.classList.add('spin-anim');
      setTimeout(() => resetBtn.classList.remove('spin-anim'), 450);
    }
    clearInterval(timerInterval);
    isRunning = false;
    endTime = null;
    timeLeft = DEFAULT_SECONDS;
    lastBeepedSecond = null; // NOVO — substitui "hasPlayedBeep = false"
    updateDisplay();
    if (toggleBtn) { toggleBtn.innerHTML = playIcon; toggleBtn.title = 'Iniciar'; }
    saveState();
  }

  /** Tecla "*": zera E já reinicia a contagem. */
  function resetAndStart() {
    if (!widget) return;
    resetTimer();
    startTimer();
  }

  /** Tecla "Page Down": só zera, sem reiniciar a contagem. */
  function resetOnly() {
    if (!widget) return;
    resetTimer();
  }

  /** Cria e insere o widget na página, restaurando estado salvo (posição/contagem). */
  function init() {
    // Mesma trava do script original: nunca cria o widget dentro de iframes.
    if (window.self !== window.top) return;
    if (document.getElementById('mute-timer-widget')) return; // já ativo

    const savedState = GM_getValue(STATE_KEY, {
      timeLeft: DEFAULT_SECONDS, isRunning: false, endTime: null, left: null, top: null
    });

    timeLeft = savedState.timeLeft;
    isRunning = savedState.isRunning;
    endTime = savedState.endTime;
    lastBeepedSecond = null;

    if (isRunning && endTime) {
      const remaining = Math.round((endTime - Date.now()) / 1000);
      if (remaining >= -1200) { timeLeft = remaining; }
      else { timeLeft = -1200; isRunning = false; endTime = null; }
    } else {
      isRunning = false;
    }

    const initialButtonHTML = isRunning ? pauseIcon : playIcon;

    const container = document.createElement('div');
    container.innerHTML = `
      <div id="mute-timer-widget" class="minimized">
        <div class="timer-header" id="timer-drag-handle">
          <span style="display: flex; align-items: center; gap: 5px;">
            <span id="status-dot" style="width: 6px; height: 6px; background: #30d158; border-radius: 50%; display: inline-block;"></span>
            <span>Timer</span>
          </span>
        </div>
        <div class="minimized-info" id="minimized-display">02:00</div>
        <div class="timer-body">
          <div class="timer-display" id="timer-countdown">02:00</div>
          <div class="timer-buttons">
            <button id="timer-toggle" class="action-btn" title="${isRunning ? 'Pausar' : 'Iniciar'}">${initialButtonHTML}</button>
            <button id="timer-reset" class="secondary-btn" title="Reiniciar">${resetIcon}</button>
          </div>
        </div>
      </div>
    `;
    document.body.appendChild(container);

    widget              = document.getElementById('mute-timer-widget');
    dragHandle          = document.getElementById('timer-drag-handle');
    displayEl           = document.getElementById('timer-countdown');
    minimizedDisplayEl  = document.getElementById('minimized-display');
    toggleBtn           = document.getElementById('timer-toggle');
    resetBtn            = document.getElementById('timer-reset');
    statusDot           = document.getElementById('status-dot');

    if (savedState.left && savedState.top) {
      widget.style.bottom = 'auto';
      widget.style.right = 'auto';
      widget.style.left = savedState.left;
      widget.style.top = savedState.top;
    }

    dragHandle.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.clientX; startY = e.clientY;
      const rect = widget.getBoundingClientRect();
      widget.style.bottom = 'auto';
      widget.style.right = 'auto';
      widget.style.top = rect.top + 'px';
      widget.style.left = rect.left + 'px';
      initialX = rect.left; initialY = rect.top;
      e.preventDefault();
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      widget.style.left = (initialX + (e.clientX - startX)) + 'px';
      widget.style.top  = (initialY + (e.clientY - startY)) + 'px';
      updateGenieOrigin();
    });

    document.addEventListener('mouseup', () => {
      if (isDragging) { isDragging = false; updateGenieOrigin(); saveState(); }
    });

    widget.addEventListener('mouseenter', () => {
      clearTimeout(hoverTimeout);
      updateGenieOrigin();
      widget.classList.remove('minimized');
    });

    widget.addEventListener('mouseleave', () => {
      if (isDragging) return;
      updateGenieOrigin();
      hoverTimeout = setTimeout(() => { if (!isDragging) widget.classList.add('minimized'); }, 1500);
    });

    toggleBtn.addEventListener('click', () => { isRunning ? pauseTimer() : startTimer(); });
    resetBtn.addEventListener('click', () => resetTimer());

    // ── Atalhos de teclado ──
    // "*"        -> zera E reinicia a contagem
    // "Page Down"-> apenas zera, sem reiniciar
    keydownHandler = (e) => {
      if (e.key === "*") { e.preventDefault(); resetAndStart(); }
      else if (e.key === "PageDown") { e.preventDefault(); resetOnly(); }
    };
    document.addEventListener("keydown", keydownHandler);

    updateGenieOrigin();
    updateDisplay();

    if (isRunning) { runInterval(); }
  }

  /** Remove o widget e limpa listeners/intervalos (chamado ao desativar nas configurações). */
  function destroy() {
    if (timerInterval) clearInterval(timerInterval);
    if (hoverTimeout) clearTimeout(hoverTimeout);
    if (keydownHandler) { document.removeEventListener("keydown", keydownHandler); keydownHandler = null; }
    const el = document.getElementById('mute-timer-widget');
    if (el) el.parentElement.remove(); // remove o container que envolve o widget
    widget = null;
    timerInterval = null;
    isDragging = false;
  }

  return { init, destroy };
})();



