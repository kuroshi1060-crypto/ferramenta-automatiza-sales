(function () {
  "use strict";

  // ══════════════════════════════════════════════════════════════════════
  //  STORAGE (substitui chrome.storage.local)
  // ══════════════════════════════════════════════════════════════════════
  const STORAGE_KEY = "FA_CONTACT_DATA";
  const START_INTERACTION_KEY = "FA_START_INTERACTION_FLAG"; // NOVA
  const CURRENT_VIEW_KEY = "FA_CURRENT_VIEW";

  function gmSetValue(key, value) { GM_setValue(key, JSON.stringify(value)); }
  function gmGetValue(key, callback) {
    const raw = GM_getValue(key, null);
    callback(raw ? JSON.parse(raw) : undefined);
  }
  function gmDeleteValue(key) { GM_deleteValue(key); }

    // Insira as funções a partir daqui:
function navegarPara(nomeTela, callbackRender) {
  gmSetValue(CURRENT_VIEW_KEY, nomeTela);
  if (typeof callbackRender === "function") {
    callbackRender();
  }
}

function carregarTelaSalva() {
  gmGetValue(CURRENT_VIEW_KEY, (telaSalva) => {
    switch (telaSalva) {
      case "create": abrirFormularioCriarContato(); break;
      case "alterar-email": abrirFormularioAlterarEmail(); break;
      case "iacs": renderMenuIacs(); break;
      case "ouvidoria": abrirFormularioOuvidoria(); break;
      case "telefoneGerais": abrirMenuTelefones(); break;
      case "lojasCidades": abrirLojasCidade(); break;
      case "configuracoes": abrirConfiguracoes(); break;
      case "telefoneGerais": abrirMenuTelefones(); break;
      case "telRio": abrirTelefonesRJ(); break;
      case "telCeara": abrirTelefonesCE(); break;
      case "telSaoPaulo": abrirTelefonesSP(); break;
      case "lojasCeara": abrirLojasCE(); break;
      case "lojasRio": abrirLojasRJ(); break;
      case "abrirMarcCasos": abrirMarcacaoCasos(); break;
      case "priorizacao": abrirFormularioPriorizacao(); break;
      case "iniciar-base": abrirBaseConhecimento(); break;
      case "menu":
default:
        navegarPara("menu", renderMenuPrincipal);
        return;
    }

    // 2. Validação: Checa se o elemento interno (#fa-body) ficou vazio após a execução
    const bodyEl = getBody();
    if (!bodyEl || !bodyEl.innerHTML.trim()) {
      navegarPara("menu", renderMenuPrincipal);
    }
  });
}

