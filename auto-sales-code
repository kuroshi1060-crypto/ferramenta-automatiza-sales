    /** Liga o arraste da borda esquerda (#fa-resizer) para redimensionar o painel. */
function setupResize(overlay) {
  const resizer = document.getElementById("fa-resizer");
  if (!resizer) return;

  let isResizing = false;
  let pendingWidth = null;
  let dragCatcher = null;
  const minWidth = 250;

  function onMouseMove(e) {
    if (!isResizing) return;
    const maxWidth = window.innerWidth * 0.9;
    const newWidth = window.innerWidth - e.clientX;
    if (newWidth >= minWidth && newWidth <= maxWidth) {
      pendingWidth = newWidth;
      requestAnimationFrame(applyWidth);
    }
  }

  function applyWidth() {
    if (pendingWidth !== null) {
      overlay.style.width = `${pendingWidth}px`;
      pendingWidth = null;
    }
  }

function stopResize() {
  if (!isResizing) return;
  isResizing = false;
  isResizingActive = false;     // NOVA: libera a lógica de transparência de novo
  resizer.classList.remove("resizing");
  document.body.style.userSelect = "";
  overlay.style.transition = "transform 0.3s ease";
  if (dragCatcher) { dragCatcher.remove(); dragCatcher = null; }
  document.removeEventListener("mousemove", onMouseMove);
  document.removeEventListener("mouseup", stopResize);

  updateFocusState(); // NOVA: reavalia o estado real de foco/hover depois do arraste
}

resizer.addEventListener("mousedown", (e) => {
  if (!appSettings.redimensionar) return;
  isResizing = true;
  isResizingActive = true;      // NOVA: bloqueia a transparência durante o arraste
  updateFocusState();           // NOVA: garante que já remove fa-unfocused se estava ativo

  resizer.classList.add("resizing");
  document.body.style.userSelect = "none";
  overlay.style.transition = "none";
  e.preventDefault();

  dragCatcher = document.createElement("div");
  Object.assign(dragCatcher.style, {
    position: "fixed", top: "0", left: "0",
    width: "100%", height: "100%",
    zIndex: "2147483647", cursor: "ew-resize",
  });
  document.body.appendChild(dragCatcher);

  document.addEventListener("mousemove", onMouseMove);
  document.addEventListener("mouseup", stopResize);
});

  applyResizerVisibility(); // aplica o estado inicial (visível/oculto)
}

    /** Liga hover/foco do painel para controlar a transparência (quando ativada nas configurações). */
function setupFocusTransparency(overlay) {
  panelOverlay = overlay;

  overlay.addEventListener("mouseenter", () => { isHoveringPanel = true; updateFocusState(); });
  overlay.addEventListener("mouseleave", () => { isHoveringPanel = false; updateFocusState(); });

  document.addEventListener("focusin", (e) => {
    isFocusInsidePanel = overlay.contains(e.target);
    updateFocusState();
  });
  document.addEventListener("focusout", () => {
    setTimeout(() => {
      isFocusInsidePanel = overlay.contains(document.activeElement);
      updateFocusState();
    }, 0);
  });

  updateFocusState();
}


