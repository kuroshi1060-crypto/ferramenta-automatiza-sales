    /** Localiza e clica no botão do utility bar que abre o iframe de Iniciar/Encerrar Interação. */
function clicarAbrirInteracao(resolve, retry) {
  const container = traverseDOM(document, n =>
    n.nodeName === "DIV" && n.getAttribute?.("data-target-selection-name") === "ATCL_LCMP034_StartCloseInteraction"
  );
  const btn = container?.querySelector("button");
  if (btn) {
    btn.click();
    resolve();
  } else {
    setTimeout(retry, 300);
  }
}

/**
 * Sinaliza (via GM storage) que o botão "Iniciar interação" deve ser
 * clicado assim que o iframe da VF carregar, e abre o painel do utility bar.
 */
async function executarIniciarInteracao() {
  gmSetValue(START_INTERACTION_KEY, true);
  try {
    await withTimeout(clicarAbrirInteracao, "Abrir painel de interação");
    showToast("✅ Abrindo interação...");
  } catch (err) {
    gmDeleteValue(START_INTERACTION_KEY);
    showToast(`❌ ${err}`);
  }
}

