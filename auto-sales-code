// Função auxiliar para converter a string SVG completa em Data URI
// Converte uma string SVG em um Data URI PNG (rasterizado via canvas)
// 1. O segredo é o 'container': a <div> externa força o clipboard e o e-mail a manterem o fundo

// Converte uma string SVG em Data URI de SVG (mantida como utilitária, usada internamente pela rasterização)
// 1. O segredo é o 'container': a <div> externa força o clipboard e o e-mail a manterem o fundo

// Converte uma string SVG em Data URI de SVG (utilitária, usada internamente pela rasterização)
function svgParaDataUri(svgString) {
    return `data:image/svg+xml;utf8,${encodeURIComponent(svgString)}`;
}

// Converte uma string SVG em um Data URI PNG (rasterizado via canvas)
// Necessário porque o Outlook não converte data:image/svg+xml em anexo no envio,
// mas converte data:image/png normalmente.
function svgParaPngDataUri(svgString, largura, altura, escala = 2) {
    return new Promise((resolve, reject) => {
        const svgDataUri = svgParaDataUri(svgString);
        const img = new Image();

        img.onload = () => {
            const canvas = document.createElement("canvas");
            canvas.width = largura * escala;
            canvas.height = altura * escala;

            const ctx = canvas.getContext("2d");
            ctx.scale(escala, escala);
            ctx.drawImage(img, 0, 0, largura, altura);

            resolve(canvas.toDataURL("image/png"));
        };

        img.onerror = (err) => reject(err);
        img.src = svgDataUri;
    });
}

