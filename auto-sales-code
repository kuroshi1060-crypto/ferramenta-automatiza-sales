    function parseCSV(text) {
        let rows = [], currentRow = [], currentCell = '', insideQuotes = false;
        for (let i = 0; i < text.length; i++) {
            let char = text[i], nextChar = text[i + 1];
            if (char === '"') {
                if (insideQuotes && nextChar === '"') { currentCell += '"'; i++; }
                else { insideQuotes = !insideQuotes; }
            } else if (char === ',' && !insideQuotes) {
                currentRow.push(currentCell.trim()); currentCell = '';
            } else if ((char === '\n' || char === '\r') && !insideQuotes) {
                if (char === '\r' && nextChar === '\n') i++;
                currentRow.push(currentCell.trim());
                if (currentRow.some(c => c.length > 0)) rows.push(currentRow);
                currentRow = []; currentCell = '';
            } else { currentCell += char; }
        }
        if (currentCell.length > 0 || currentRow.length > 0) {
            currentRow.push(currentCell.trim());
            if (currentRow.some(c => c.length > 0)) rows.push(currentRow);
        }
        return rows;
    }

    function formatarCampoTSV(valor) {
        const v = (valor === null || valor === undefined) ? '' : String(valor);
        if (v.includes('\t') || v.includes('\n') || v.includes('"')) {
            return '"' + v.replace(/"/g, '""') + '"';
        }
        return v;
    }

    function buscarCSV(gid, onSucesso, onErro, spreadsheetId) {
        const idFinal = spreadsheetId || PLANILHA_ID;
        if (!idFinal || idFinal.includes("COLE_AQUI")) {
            if (onErro) onErro("O ID da planilha não foi configurado no script.");
            return;
        }
        GM_xmlhttpRequest({
            method: "GET",
            url: urlCSV(gid, idFinal),
            onload: function (response) {
                try {
                    if (response.status >= 400) {
                        if (onErro) onErro(`Erro HTTP ${response.status}. Verifique permissões da planilha e o GID "${gid}".`);
                        return;
                    }
                    const matriz = parseCSV(response.responseText);
                    if (matriz.length > 0) matriz.shift();
                    onSucesso(matriz);
                } catch (e) {
                    if (onErro) onErro("Erro ao processar dados da planilha.");
                }
            },
            onerror: function () {
                if (onErro) onErro("Não foi possível conectar à planilha do Google.");
            }
        });
    }

