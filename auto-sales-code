function ativarEditorRico(idBase) {
    const editor = document.getElementById(idBase);
    const toolsPanel = document.getElementById(`${idBase}-table-tools`);
    if (!editor) return;

    editor.addEventListener('keydown', (e) => e.stopPropagation());
    editor.addEventListener('keyup', (e) => e.stopPropagation());
    editor.addEventListener('keypress', (e) => e.stopPropagation());

    function executarComando(cmd, param = null) {
        editor.focus();
        document.execCommand(cmd, false, param);
    }

    function vincularBotao(idBtn, acao) {
        const btn = document.getElementById(idBtn);
        if (!btn) return;
        btn.addEventListener('mousedown', (e) => {
            e.preventDefault();
            acao();
        });
    }

    vincularBotao(`${idBase}-bold`, () => executarComando('bold'));
    vincularBotao(`${idBase}-italic`, () => executarComando('italic'));
    vincularBotao(`${idBase}-underline`, () => executarComando('underline'));
    vincularBotao(`${idBase}-strike`, () => executarComando('strikeThrough'));
    vincularBotao(`${idBase}-alignleft`, () => executarComando('justifyLeft'));
    vincularBotao(`${idBase}-aligncenter`, () => executarComando('justifyCenter'));
    vincularBotao(`${idBase}-alignright`, () => executarComando('justifyRight'));
    vincularBotao(`${idBase}-ul`, () => executarComando('insertUnorderedList'));
    vincularBotao(`${idBase}-ol`, () => executarComando('insertOrderedList'));
    vincularBotao(`${idBase}-clear`, () => executarComando('removeFormat'));

    // EVENTOS DE COR DA FONTE E FUNDO DO TÍTULO
    const fontColorInput = document.getElementById(`${idBase}-fontcolor`);
    if (fontColorInput) {
        fontColorInput.addEventListener('input', () => {
            executarComando('foreColor', fontColorInput.value);
        });
    }

    const titleBgInput = document.getElementById(`${idBase}-titlebg`);
    if (titleBgInput) {
        titleBgInput.addEventListener('input', () => {
            const sel = window.getSelection();
            if (!sel || !sel.rangeCount) return;
            let node = sel.getRangeAt(0).commonAncestorContainer;
            while (node && node !== editor) {
                if (node.tagName === 'H3') {
                    node.style.background = titleBgInput.value;
                    return;
                }
                node = node.parentNode;
            }
            executarComando('formatBlock', '<h3>');
            const newSel = window.getSelection();
            if (newSel && newSel.rangeCount) {
                let newNode = newSel.getRangeAt(0).commonAncestorContainer;
                while (newNode && newNode !== editor) {
                    if (newNode.tagName === 'H3') {
                        newNode.style.background = titleBgInput.value;
                        break;
                    }
                    newNode = newNode.parentNode;
                }
            }
        });
    }

    const fontSizeSelect = document.getElementById(`${idBase}-fontsize`);
    if (fontSizeSelect) {
        fontSizeSelect.addEventListener('change', () => {
            if (fontSizeSelect.value) {
                executarComando('fontSize', fontSizeSelect.value);
            }
        });
    }

    vincularBotao(`${idBase}-titulo`, () => {
        const block = document.queryCommandValue('formatBlock');
        if (block === 'h3' || block === 'H3') {
            executarComando('formatBlock', '<p>');
        } else {
            executarComando('formatBlock', '<h3>');
        }
    });

    function obterCelulaAtual() {
        const sel = window.getSelection();
        if (!sel || !sel.rangeCount) return null;
        let node = sel.getRangeAt(0).commonAncestorContainer;
        while (node && node !== editor) {
            if (node.tagName === 'TD' || node.tagName === 'TH') return node;
            node = node.parentNode;
        }
        return null;
    }

    function checarExibirFerramentasTabela() {
        const celula = obterCelulaAtual();
        if (toolsPanel) {
            toolsPanel.style.display = celula ? 'flex' : 'none';
        }
    }

    ['click', 'keyup', 'focus', 'selectstart'].forEach(evt => {
        editor.addEventListener(evt, checarExibirFerramentasTabela);
    });

    // COR DE FUNDO DA CÉLULA/TABELA
    const cellBgInput = document.getElementById(`${idBase}-cellbg`);
    if (cellBgInput) {
        cellBgInput.addEventListener('input', () => {
            const celula = obterCelulaAtual();
            if (celula) celula.style.backgroundColor = cellBgInput.value;
        });
    }

    // REDIMENSIONAMENTO DE COLUNA E LINHA
    vincularBotao(`${idBase}-col-w-inc`, () => {
        const celula = obterCelulaAtual();
        if (!celula) return;
        const curW = celula.offsetWidth;
        celula.style.width = (curW + 25) + 'px';
    });

    vincularBotao(`${idBase}-col-w-dec`, () => {
        const celula = obterCelulaAtual();
        if (!celula) return;
        const curW = celula.offsetWidth;
        if (curW > 30) celula.style.width = Math.max(25, curW - 25) + 'px';
    });

    vincularBotao(`${idBase}-row-h-inc`, () => {
        const celula = obterCelulaAtual();
        if (!celula) return;
        const tr = celula.parentElement;
        const curH = tr.offsetHeight;
        tr.style.height = (curH + 15) + 'px';
    });

    vincularBotao(`${idBase}-row-h-dec`, () => {
        const celula = obterCelulaAtual();
        if (!celula) return;
        const tr = celula.parentElement;
        const curH = tr.offsetHeight;
        if (curH > 20) tr.style.height = Math.max(20, curH - 15) + 'px';
    });

    vincularBotao(`${idBase}-table-btn`, () => {
        abrirModalCriarTabela((rows, cols, hasHeader) => {
            let tableHTML = '<table style="width:100%; border-collapse:collapse; margin:12px 0; border:1px solid var(--kbp-card-border);">';
            if (hasHeader) {
                tableHTML += '<thead><tr>';
                for (let j = 0; j < cols; j++) {
                    tableHTML += `<th>Cabeçalho ${j + 1}</th>`;
                }
                tableHTML += '</tr></thead>';
            }
            tableHTML += '<tbody>';
            const startRow = hasHeader ? 1 : 0;
            for (let i = startRow; i < rows; i++) {
                tableHTML += '<tr>';
                for (let j = 0; j < cols; j++) {
                    tableHTML += `<td>Item ${i + 1}-${j + 1}</td>`;
                }
                tableHTML += '</tr>';
            }
            tableHTML += '</tbody></table><p><br></p>';

            editor.focus();
            if (document.queryCommandSupported('insertHTML')) {
                document.execCommand('insertHTML', false, tableHTML);
            }
            checarExibirFerramentasTabela();
        });
    });

    // Adicionar/Excluir/Mesclar
    vincularBotao(`${idBase}-row-add`, () => {
        const celula = obterCelulaAtual();
        if (!celula) return;
        const tr = celula.parentElement;
        const novaLinha = document.createElement('tr');
        const numCols = tr.children.length;
        for (let i = 0; i < numCols; i++) {
            const td = document.createElement('td');
            td.innerHTML = '&nbsp;';
            novaLinha.appendChild(td);
        }
        tr.after(novaLinha);
    });

    vincularBotao(`${idBase}-col-add`, () => {
        const celula = obterCelulaAtual();
        if (!celula) return;
        const index = celula.cellIndex;
        const tabela = celula.closest('table');
        if (!tabela) return;

        Array.from(tabela.rows).forEach(row => {
            const refCell = row.cells[index];
            const tag = (row.parentElement && row.parentElement.tagName === 'THEAD') ? 'th' : 'td';
            const novaCelula = document.createElement(tag);
            novaCelula.innerHTML = '&nbsp;';
            if (refCell) refCell.after(novaCelula);
            else row.appendChild(novaCelula);
        });
    });

    vincularBotao(`${idBase}-row-del`, () => {
        const celula = obterCelulaAtual();
        if (!celula) return;
        const tr = celula.parentElement;
        const tabela = tr.closest('table');
        tr.remove();
        if (tabela && tabela.rows.length === 0) tabela.remove();
        checarExibirFerramentasTabela();
    });

    vincularBotao(`${idBase}-col-del`, () => {
        const celula = obterCelulaAtual();
        if (!celula) return;
        const index = celula.cellIndex;
        const tabela = celula.closest('table');
        if (!tabela) return;

        Array.from(tabela.rows).forEach(row => {
            if (row.cells[index]) row.cells[index].remove();
        });
        checarExibirFerramentasTabela();
    });

    vincularBotao(`${idBase}-merge-right`, () => {
        const celula = obterCelulaAtual();
        if (!celula) return;
        const proxima = celula.nextElementSibling;
        if (!proxima) return;
        celula.colSpan = (celula.colSpan || 1) + (proxima.colSpan || 1);
        celula.innerHTML = (celula.innerHTML.trim() + ' ' + proxima.innerHTML.trim()).trim();
        proxima.remove();
    });

    vincularBotao(`${idBase}-merge-down`, () => {
        const celula = obterCelulaAtual();
        if (!celula) return;
        const tr = celula.parentElement;
        const tabela = tr.closest('table');
        if (!tabela) return;
        const rowIndex = tr.rowIndex;
        const cellIndex = celula.cellIndex;
        const rSpanAtual = celula.rowSpan || 1;
        const proximaLinha = tabela.rows[rowIndex + rSpanAtual];
        if (!proximaLinha) return;
        const celulaAbaixo = proximaLinha.cells[cellIndex];
        if (!celulaAbaixo) return;
        celula.rowSpan = rSpanAtual + (celulaAbaixo.rowSpan || 1);
        celula.innerHTML = (celula.innerHTML.trim() + ' ' + celulaAbaixo.innerHTML.trim()).trim();
        celulaAbaixo.remove();
    });

    vincularBotao(`${idBase}-split-cell`, () => {
        const celula = obterCelulaAtual();
        if (!celula) return;
        const cSpan = celula.colSpan || 1;
        if (cSpan > 1) {
            celula.colSpan = 1;
            for (let i = 1; i < cSpan; i++) {
                const nova = document.createElement('td');
                nova.innerHTML = '&nbsp;';
                celula.after(nova);
            }
        }
        celula.rowSpan = 1;
    });

    vincularBotao(`${idBase}-table-del`, () => {
        const celula = obterCelulaAtual();
        if (!celula) return;
        const tabela = celula.closest('table');
        if (tabela) tabela.remove();
        checarExibirFerramentasTabela();
    });
}

