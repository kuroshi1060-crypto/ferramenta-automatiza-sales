    function descriptografarTexto(textoCripto, chave = CHAVE_SECRETA) {
        if (!textoCripto) return "";
        let str = String(textoCripto).trim();
        if (!str.startsWith("ENC:")) return str;
        try {
            const binary = atob(str.replace("ENC:", ""));
            const encoder = new TextEncoder();
            const keyBytes = encoder.encode(chave);
            const decBytes = new Uint8Array(binary.length);
            for (let i = 0; i < binary.length; i++) {
                decBytes[i] = binary.charCodeAt(i) ^ keyBytes[i % keyBytes.length];
            }
            const decoder = new TextDecoder();
            return decoder.decode(decBytes);
        } catch (e) {
            console.error("Erro ao descriptografar:", e);
            return "";
        }
    }

